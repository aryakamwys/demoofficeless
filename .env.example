# ============================================================
# Perkom Expense Approval Bot — Environment Variables
# Salin ke .env.local untuk dev, atau set di Vercel (Production).
# File ini cuma contoh — JANGAN isi nilai asli di sini.
# ============================================================

# --- Kirimi WhatsApp (kirim notifikasi WA) ---
# Akun di https://api.kirimi.id
KIRIMI_USER_CODE=contoh-user-code
KIRIMI_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
KIRIMI_DEVICE_ID=1234

# --- InvGate Service Desk (tiket Service Desk) ---
# Basic auth ke https://servicedesk.perkom.co.id/api/v1
SERVICEDESK_USERNAME=user@perkom.co.id
SERVICEDESK_PASSWORD=password-anda

# --- Supabase (auth + database — WAJIB, dipakai seluruh app) ---
# Project Settings > API di dashboard Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-only (service role, bypass RLS) — JANGAN pernah expose ke client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Upstash Redis (cache API — OPSIONAL) ---
# Tanpa ini app tetap jalan, hanya tanpa cache (tiap request nabrak API upstream)
UPSTASH_REDIS_REST_URL=https://global-xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXXxxxxxxxxxxxxxxxxxxxxxx

# --- Dokumentasi (opsional, hanya dipakai scripts/capture-docs.mjs) ---
DOCS_BASE_URL=http://localhost:3000
