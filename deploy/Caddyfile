# Reverse proxy DI BELAKANG Cloudflare Tunnel.
#
# Topologi: browser --https--> Cloudflare edge --tunnel--> cloudflared
#           --http://caddy:80--> Caddy ini.
# Enkripsi browser<->Cloudflare ditangani Cloudflare. Upgrade http->https
# harus di EDGE (Cloudflare: Always Use HTTPS), BUKAN di sini — permintaan
# dari tunnel selalu http, redirect https di sini = loop tanpa akhir.

{
	auto_https off		# tanpa TLS lokal: origin plain HTTP di belakang tunnel
	email admin@perkom.co.id
}

# Kedua hostname (app + subdomain Supabase) melayani kombinasi route yang sama.
http://{$APP_DOMAIN}, http://{$SB_DOMAIN} {
	encode gzip
	request_body {
		max_size 25MB		# upload PDF klaim
	}

	# API Supabase self-host — handle_path meng-strip prefix yang cocok
	# (service menerima path tanpa /xxx/v1)
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	handle_path /storage/v1/* {
		reverse_proxy storage:5000
	}

	# Sisanya → aplikasi Next.js
	reverse_proxy app:3000
}
