# Reverse proxy utama — TLS Let's Encrypt otomatis.
# SATU domain untuk semuanya: aplikasi + API Supabase self-host
# (NEXT_PUBLIC_SUPABASE_URL mengarah ke domain yang sama).

{
	email admin@perkom.co.id	# email akun ACME
}

# HTTP → HTTPS eksplisit. Pernah terjadi: http://domain lolos sampai ke app
# tanpa di-upgrade — cookie login (Secure) tidak pernah terpasang, sehingga
# pengguna seolah "selalu dilempar ke login".
http://{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

{$APP_DOMAIN} {
	encode gzip
	request_body {
		max_size 25MB		# upload PDF klaim
	}

	# API Supabase self-host — handle_path meng-strip prefix yang cocok
	# (service menerima path tanpa /xxx/v1)
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	handle_path /storage/v1/* {
		reverse_proxy storage:5000
	}

	# Sisanya → aplikasi Next.js
	reverse_proxy app:3000
}
